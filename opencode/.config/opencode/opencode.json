{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "snapaddy-components": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "markdown-mcp-resource@latest",
        "https://components.snapaddy.com/assets/mcp/index.json"
      ],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgres://sa_backend:mySecretDBPassword@localhost:5432/postgres"
      ],
      "enabled": false
    }
  }
}
