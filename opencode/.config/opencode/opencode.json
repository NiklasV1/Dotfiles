{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "snapaddy-components": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "-y",
        "markdown-mcp-resource@latest",
        "https://components.snapaddy.com/assets/mcp/index.json"
      ],
      "enabled": false
    },
    "translation-editor": {
      "type": "local",
      "command": [
        "/home/niklasv/translation-mcp.zsh"
      ],
      "enabled": false
    },
    "angular": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "-y",
        "@angular/cli",
        "mcp",
        "--experimental-tool"
      ],
      "enabled": false
    },
    "chrome": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgres://sa_backend:mySecretDBPassword@localhost:5432/postgres"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-pat}"
      }
    }
  }
}
