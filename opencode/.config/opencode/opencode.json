{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "snapaddy-components": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "markdown-mcp-resource@latest",
        "https://components.snapaddy.com/assets/mcp/index.json"
      ],
      "enabled": false
    },
    "translation-editor": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@snapaddy/i18n-cli",
        "mcp"
      ],
      "enabled": false
    },
    "angular": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@angular/cli",
        "mcp",
        "--experimental-tool"
      ],
      "enabled": false
    },
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ],
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgres://sa_backend:mySecretDBPassword@localhost:5432/postgres"
      ],
      "enabled": false
    }
  }
}
